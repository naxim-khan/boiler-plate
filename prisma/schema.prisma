datasource db {
  provider = "postgresql"
  // *No* `url` here — Prisma 7+ expects the URL passed at runtime or via config
}

generator client {
  provider   = "prisma-client"
  engineType = "client"
  output     = "../src/generated"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}
